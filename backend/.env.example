# Puerto donde arranca el servidor. Si no se define, usa 3000
PORT=3000

# Datos de conexión a SQL Server
# DB_SERVER: nombre o IP del servidor (ej. localhost, o la IP del servidor de COHORSIL)
# DB_INSTANCE: nombre de la instancia de SQL Server (ej. SQLEXPRESS). Dejar vacío si no aplica
# DB_DATABASE: nombre de la base de datos (ej. srf_faltantes)
DB_SERVER=
DB_INSTANCE=
DB_DATABASE=

# Nota de conexión: este proyecto usa mssql/msnodesqlv8 con trustedConnection (autenticación de
# Windows) y requiere el "ODBC Driver 18 for SQL Server" instalado en la máquina donde corre el
# backend. Si el servidor de destino usa autenticación de SQL Server (usuario/contraseña) en vez
# de autenticación de Windows, hay que ajustar backend/src/config/db.js antes de desplegar.

# Secreto para firmar los tokens JWT del login. Usar un valor largo y aleatorio, distinto en cada
# ambiente (no reusar el de desarrollo en producción)
JWT_SECRET=

# Cuenta de Gmail que envía el correo automático cuando se registra un faltante
# EMAIL_PASS debe ser una contraseña de aplicación de Gmail, no la contraseña normal de la cuenta
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
